# -----------------------------------------
# Arquivo: Dockerfile.python-runtime
# Estágio: python-runtime
# Objetivo: preparar o ambiente mínimo para Python funcionar
# -----------------------------------------
ARG SDOCKER_PYTHON_IMAGE=python:3.12-slim-bullseye
FROM ${SDOCKER_PYTHON_IMAGE} AS sdocker-python-runtime

# 1.1. Variáveis de ambiente para Python
ENV PYTHONUNBUFFERED=1          # Desabilita buffering de saída do Python (logs em tempo real)
ENV PYTHONDONTWRITEBYTECODE=1   # Impede geração de arquivos .pyc nos diretórios de origem

# 1.2. Configuração de localidade e fuso horário
ENV LANG=pt_BR.UTF-8
ENV LANGUAGE=pt_BR:pt
ENV LC_ALL=pt_BR.UTF-8
ENV TZ="America/Fortaleza"

# 1.3. Evita interações durante instalação de pacotes
ENV DEBIAN_FRONTEND=noninteractive

# 1.4. Otimiza instalação de pacotes usando caching de listas APT
RUN export LANG=C.UTF-8 && \
    --mount=target=/var/lib/apt/lists,type=cache,sharing=locked \
    --mount=target=/var/cache/apt,type=cache,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    sed -i -e 's/ main/ main contrib non-free/g' /etc/apt/sources.list

# 1.5. Instalação de dependências essenciais de sistema para Python minimal
RUN apt-get update -qq && apt-get install -yqq --no-install-recommends \
      python3-setuptools \     # Ferramentas de empacotamento Python
      python3-wheel \          # Criação e instalação de pacotes no formato wheel
      pip \                    # Instalador de pacotes Python
      locales                  # Definições de localidade (idioma, data, hora) \
    && echo "pt_BR.UTF-8 UTF-8" >> /etc/locale.gen \
    && locale-gen pt_BR.UTF-8 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 1.6. Atualização do pip e instalação do Poetry
RUN pip install --upgrade pip && \
    curl -sSL https://install.python-poetry.org | python -
